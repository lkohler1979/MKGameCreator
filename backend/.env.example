PORT=3333

# Aponta para o serviço "postgres" do docker-compose
DATABASE_URL="postgresql://mkgamecreator:mkgamecreator@postgres:5432/mkgamecreator?schema=public"

# Origem exata (sem barra no final) permitida a chamar a API com cookies -
# tem que ser a URL publica do frontend, nao "true"/reflect-all (com
# credentials:true isso vazaria dados autenticados pra qualquer site)
CORS_ORIGIN=http://localhost:3050

# Dominio do cookie de sessao - vazio em dev (fica preso a "localhost",
# que ja cobre frontend e backend em portas diferentes). Em producao,
# preencher com o dominio pai compartilhado pelos dois subdominios, ex.:
# COOKIE_DOMAIN=.unifyhub.com.br
COOKIE_DOMAIN=

# Preencher com um projeto Supabase (cloud) real - Storage ainda nao
# integrado (auth real ja existe via sessao propria, ver /auth/* e
# CORS_ORIGIN/COOKIE_DOMAIN acima - nao depende do Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
