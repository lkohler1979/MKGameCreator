generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  GOOGLE
  MICROSOFT
  // usuário de desenvolvimento automático, enquanto não existe login real (Sprint 1)
  DEV
}

enum SpriteSource {
  DRAWING
  PRESET
}

enum GameTemplate {
  PLATFORM
  MAZE
}

model User {
  id        String       @id @default(uuid())
  email     String       @unique
  name      String?
  avatarUrl String?
  provider  AuthProvider
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sprites  Sprite[]
  games    Game[]
  sessions GameSession[]
}

model Sprite {
  id               String       @id @default(uuid())
  userId           String
  source           SpriteSource
  originalImageUrl String?
  spriteImageUrl   String
  createdAt        DateTime     @default(now())

  user  User   @relation(fields: [userId], references: [id])
  games Game[]
}

model Game {
  id           String       @id @default(uuid())
  userId       String
  spriteId     String
  name         String
  templateType GameTemplate @default(PLATFORM)
  sceneConfig  Json
  shareSlug    String       @unique @default(cuid())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  sprite   Sprite        @relation(fields: [spriteId], references: [id])
  sessions GameSession[]
}

model GameSession {
  id             String    @id @default(uuid())
  gameId         String
  userId         String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  completed      Boolean   @default(false)
  timeSeconds    Int?
  coinsCollected Int       @default(0)
  livesRemaining Int?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}
