generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  GOOGLE
  MICROSOFT
  EMAIL
  // usuário de desenvolvimento automático, usado antes de existir login real — sem uso desde a Fase 3
  DEV
}

enum SpriteSource {
  DRAWING
  PRESET
}

enum GameTemplate {
  PLATFORM
  MAZE
  COLLECT
  BRICK_BREAKER
  RACE
  AIR_HOCKEY
}

enum GameVisibility {
  PRIVATE
  PUBLIC
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String?
  avatarUrl    String?
  provider     AuthProvider
  passwordHash String?
  colorRoleMap Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sprites      Sprite[]
  games        Game[]
  sessions     GameSession[]
  authSessions AuthSession[]
  favorites    Favorite[]
  gameReports  GameReport[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sprite {
  id               String       @id @default(uuid())
  userId           String
  source           SpriteSource
  originalImageUrl String?
  spriteImageUrl   String
  createdAt        DateTime     @default(now())

  user  User   @relation(fields: [userId], references: [id])
  games Game[]
}

model Game {
  id           String         @id @default(uuid())
  userId       String
  spriteId     String
  name         String
  templateType GameTemplate   @default(PLATFORM)
  visibility   GameVisibility @default(PRIVATE)
  sceneConfig  Json
  shareSlug    String         @unique @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  sprite    Sprite        @relation(fields: [spriteId], references: [id])
  sessions  GameSession[]
  favorites Favorite[]
  reports   GameReport[]
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model GameReport {
  id         String   @id @default(uuid())
  gameId     String
  reporterId String
  reason     String?
  createdAt  DateTime @default(now())

  game     Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}

model GameSession {
  id             String    @id @default(uuid())
  gameId         String
  userId         String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  completed      Boolean   @default(false)
  timeSeconds    Int?
  coinsCollected Int       @default(0)
  livesRemaining Int?

  game Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
}
